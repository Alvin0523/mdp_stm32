/*
 * Devicetree overlay for WHEELTEC C30D (Revision 2.1) Control Board
 * Based on STM32F407VET6 MCU and AT8236 motor drivers.
 */

/ {
	leds {
		compatible = "gpio-leds";
		c30d_led: led_0 {
			gpios = <&gpioe 8 GPIO_ACTIVE_HIGH>;
			label = "C30D LED (PE8)";
		};
	};

	aliases {
		led0 = &c30d_led;
	};
};

/*
 * USART3 -> C30D USB-serial #3 (USB Type-C) on PD8 (TX3) and PD9 (RX3).
 * Connected via CH9102F USB-to-UART chip.
 */
&usart3 {
	pinctrl-0 = <&usart3_tx_pd8 &usart3_rx_pd9>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
	label = "UART_3";
};

/*
 * AT8236 Dual H-Bridge Motor Drivers (PWM Output Timers)
 *
 * Motor A (Rear Left):  PB8 (TIM10_CH1) / PB9 (TIM11_CH1)
 * Motor B (Rear Right): PE5 (TIM9_CH1)  / PE6 (TIM9_CH2)
 * Motor C & D:          PE9, PE11, PE13, PE14 (TIM1)
 */
&timers10 {
	status = "okay";
	motor_a_in1_pwm: pwm {
		status = "okay";
		pinctrl-0 = <&tim10_ch1_pb8>;
		pinctrl-names = "default";
	};
};

&timers11 {
	status = "okay";
	motor_a_in2_pwm: pwm {
		status = "okay";
		pinctrl-0 = <&tim11_ch1_pb9>;
		pinctrl-names = "default";
	};
};

&timers9 {
	status = "okay";
	motor_b_pwm: pwm {
		status = "okay";
		pinctrl-0 = <&tim9_ch1_pe5 &tim9_ch2_pe6>;
		pinctrl-names = "default";
	};
};

